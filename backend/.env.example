# Database and application secrets
DATABASE_URL=mysql+pymysql://root:@localhost:3306/secure_messenger
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=replace-this-admin-password
ADMIN_SECRET_PATH=sm-admin-x9k2p7
UPLOAD_FOLDER=uploads

# Phone verification delivery
# Production: sms_ir. Local manual testing: console (prints OTP only to the
# backend log; it is never sent back in an API response).
SMS_DELIVERY_MODE=sms_ir
SMS_IR_API_KEY=gcfVDPU5q2ANOq58xcpRUi9zWZ2NnynVlfNvG8ILxTjWcv7v
SMS_IR_TEMPLATE_ID=683447
# Use the exact parameter names created in SMS.ir. The default sends one CODE
# parameter. For a two-parameter template, uncomment and adapt this JSON:
SMS_IR_CODE_PARAMETER=CODE
# SMS_IR_TEMPLATE_PARAMETERS={"CODE":"{code}","APP":"SecureMessenger"}
SMS_IR_TIMEOUT_SECONDS=10

# Server-side OTP controls. Do not lower these values in production.
PHONE_CODE_TTL_SECONDS=600
PHONE_CODE_RESEND_SECONDS=300
PHONE_CODE_MAX_ATTEMPTS=5
PHONE_CODE_MAX_PER_HOUR=5
PHONE_CODE_MAX_PER_IP_HOUR=20

# Optional Firebase Cloud Messaging wake-up ticks (see FCM_SETUP.md).
# Leave all three empty to run on local polling only — nothing breaks.
FCM_PROJECT_ID=
# Either the path to the service-account JSON file (recommended; keep the
# file outside the repo and chmod 600 it) ...
FCM_SERVICE_ACCOUNT_FILE=
# ... or the whole JSON inlined as a single line:
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Upload limits are controlled from the admin panel (Settings page) and are
# stored in the database — per media category (image/video/audio/voice/file),
# with optional per-user caps. MAX_CONTENT_LENGTH stays the hard
# whole-request ceiling; keep it at or above the largest category limit:
# MAX_CONTENT_LENGTH=52428800
